{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "sources": "https://github.com/CartoonishVillain/ImmortuosCalyx"
    },
    "license": "${license}",
    "icon": "${mod_id}.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.cartoonishvillain.immortuoscalyx.FabricImmortuos"
        ],
        "client":[
            "com.cartoonishvillain.immortuoscalyx.FabricImmortuosClient"
        ],
        "cardinal-components-entity": [
            "com.cartoonishvillain.immortuoscalyx.data.player.PlayerComponentStarter"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "${minecraft_version}",
        "trinkets": "*",
        "java": ">=17"
    },
    "recommends": {
        "patchouli": "*"
    },
    "suggests": {
        "incapacitated": "*"
    },

    "custom": {
        "cardinal-components": [
            "immortuoscalyx:infectiondata"
        ]
    },
    "accessWidener" : "${mod_id}.accesswidener"
}
  